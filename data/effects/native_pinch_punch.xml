<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="kdenlive_pinch_punch" id="kdenlive_pinch_punch" type="video">
    <name>Pinch/Punch Warp</name>
    <description>Native CPU radial warp. Negative Amount pinches inward and positive Amount punches outward. The source VEGAS DirectX mapping is proprietary; this radial reconstruction preserves the decoded motion and controls.</description>
    <author>Kdenlive</author>
    <parameter type="animated" name="amount_adjust" default="0" min="-2" max="2" decimals="3"><name>Amount curve adjustment</name></parameter>
    <parameter type="animated" name="center_x_adjust" default="0" min="-1" max="1" decimals="3"><name>Center X adjustment</name></parameter>
    <parameter type="animated" name="center_y_adjust" default="0" min="-1" max="1" decimals="3"><name>Center Y adjustment</name></parameter>
    <parameter type="animated" name="horizontal_adjust" default="1" min="0.01" max="8" decimals="3"><name>Horizontal width multiplier</name></parameter>
    <parameter type="animated" name="vertical_adjust" default="1" min="0.01" max="8" decimals="3"><name>Vertical height multiplier</name></parameter>
    <parameter type="animated" name="proportional" default="1" min="0" max="1" decimals="0"><name>Proportional</name></parameter>
    <parameter type="animated" name="wrap_x" default="2" min="0" max="2" decimals="0"><name>Horizontal edge mode (0 transparent, 1 tile, 2 reflect)</name></parameter>
    <parameter type="animated" name="wrap_y" default="2" min="0" max="2" decimals="0"><name>Vertical edge mode (0 transparent, 1 tile, 2 reflect)</name></parameter>
    <parameter type="animated" name="subpixel" default="1" min="0" max="1" decimals="0"><name>Subpixel sampling</name></parameter>
    <parameter type="fixed" name="native_curves" default="{}" />
    <parameter type="fixed" name="amount" default="0" />
    <parameter type="fixed" name="center_x" default="0" />
    <parameter type="fixed" name="center_y" default="0" />
    <parameter type="fixed" name="horizontal" default="1" />
    <parameter type="fixed" name="vertical" default="1" />
    <parameter type="fixed" name="native_event_frames" default="0" />
    <parameter type="fixed" name="native_nominal_frames" default="0" />
    <parameter type="fixed" name="native_curve_start" default="0" />
    <parameter type="fixed" name="native_curve_end" default="1" />
    <parameter type="fixed" name="native_event_role" default="outgoing" />
    <parameter type="fixed" name="native_fit_version" default="0" />
    <parameter type="fixed" name="native_preset_id" default="" />
    <parameter type="fixed" name="native_preset_schema_version" default="0" />
</effect>
