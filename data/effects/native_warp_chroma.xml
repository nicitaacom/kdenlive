<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="kdenlive_warp_chroma" id="kdenlive_warp_chroma" type="video">
    <name>Spectral Chroma Warp</name>
    <description>Samples multiple spatial transforms between red and blue to separate source colors. This native spectral reconstruction uses its own weighting kernel and does not certify a Sapphire preset.</description>
    <author>Kdenlive</author>
    <parameter type="animated" name="center_x_adjust" default="0" min="-2" max="2" decimals="3"><name>Center X adjustment</name></parameter>
    <parameter type="animated" name="center_y_adjust" default="0" min="-2" max="2" decimals="3"><name>Center Y adjustment</name></parameter>
    <parameter type="animated" name="from_z_distance_adjust" default="1" min="0.001" max="8" decimals="3"><name>Red-end Z distance multiplier</name></parameter>
    <parameter type="animated" name="to_z_distance_adjust" default="1" min="0.001" max="8" decimals="3"><name>Blue-end Z distance multiplier</name></parameter>
    <parameter type="animated" name="from_rotation_adjust" default="0" min="-720" max="720" decimals="2"><name>Red-end rotation adjustment</name></parameter>
    <parameter type="animated" name="to_rotation_adjust" default="0" min="-720" max="720" decimals="2"><name>Blue-end rotation adjustment</name></parameter>
    <parameter type="animated" name="from_shift_x_adjust" default="0" min="-4" max="4" decimals="3"><name>Red-end shift X adjustment</name></parameter>
    <parameter type="animated" name="from_shift_y_adjust" default="0" min="-4" max="4" decimals="3"><name>Red-end shift Y adjustment</name></parameter>
    <parameter type="animated" name="to_shift_x_adjust" default="0" min="-4" max="4" decimals="3"><name>Blue-end shift X adjustment</name></parameter>
    <parameter type="animated" name="to_shift_y_adjust" default="0" min="-4" max="4" decimals="3"><name>Blue-end shift Y adjustment</name></parameter>
    <parameter type="animated" name="warp_amount_adjust" default="1" min="0" max="4" decimals="3"><name>Warp amount multiplier</name></parameter>
    <parameter type="animated" name="brightness_adjust" default="1" min="0" max="4" decimals="3"><name>Brightness multiplier</name></parameter>
    <parameter type="animated" name="spectrum_steps" default="15" min="3" max="100" decimals="0"><name>Spectrum samples</name></parameter>
    <parameter type="animated" name="wrap_x" default="0" min="0" max="2" decimals="0"><name>Horizontal edge mode</name></parameter>
    <parameter type="animated" name="wrap_y" default="0" min="0" max="2" decimals="0"><name>Vertical edge mode</name></parameter>
    <parameter type="animated" name="subpixel" default="1" min="0" max="1" decimals="0"><name>Subpixel sampling</name></parameter>
    <parameter type="fixed" name="native_curves" default="{}" />
    <parameter type="fixed" name="center_x" default="0.5" />
    <parameter type="fixed" name="center_y" default="0.5" />
    <parameter type="fixed" name="from_z_distance" default="1" />
    <parameter type="fixed" name="to_z_distance" default="1" />
    <parameter type="fixed" name="from_rotation" default="0" />
    <parameter type="fixed" name="to_rotation" default="0" />
    <parameter type="fixed" name="from_shift_x" default="0" />
    <parameter type="fixed" name="from_shift_y" default="0" />
    <parameter type="fixed" name="to_shift_x" default="0" />
    <parameter type="fixed" name="to_shift_y" default="0" />
    <parameter type="fixed" name="warp_amount" default="1" />
    <parameter type="fixed" name="brightness" default="1" />
    <parameter type="fixed" name="native_event_frames" default="0" />
    <parameter type="fixed" name="native_curve_start" default="0" />
    <parameter type="fixed" name="native_curve_end" default="1" />
    <parameter type="fixed" name="native_event_role" default="outgoing" />
    <parameter type="fixed" name="native_fit_version" default="0" />
    <parameter type="fixed" name="native_preset_id" default="" />
    <parameter type="fixed" name="native_preset_schema_version" default="0" />
</effect>
