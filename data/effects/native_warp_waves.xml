<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="kdenlive_warp_waves" id="kdenlive_warp_waves" type="video">
    <name>Wave Pattern Warp</name>
    <description>Native animated sinusoidal coordinate warp. Amplitude, spatial frequency, wave angle, displacement angle, phase, zoom, and reflected source borders remain editable. The wave field is a documented reconstruction of the source operation.</description>
    <author>Kdenlive</author>
    <parameter type="animated" name="amplitude_adjust" default="0" min="-1" max="1" decimals="4"><name>Amplitude adjustment (frame fraction)</name></parameter>
    <parameter type="animated" name="frequency_adjust" default="0" min="-16" max="16" decimals="3"><name>Frequency adjustment</name></parameter>
    <parameter type="animated" name="angle_adjust" default="0" min="-180" max="180" decimals="2"><name>Wave angle adjustment (degrees)</name></parameter>
    <parameter type="animated" name="displace_angle_adjust" default="0" min="-180" max="180" decimals="2"><name>Displacement angle adjustment (degrees)</name></parameter>
    <parameter type="animated" name="phase_start_adjust" default="0" min="-8" max="8" decimals="3"><name>Phase adjustment</name></parameter>
    <parameter type="animated" name="phase_speed_adjust" default="0" min="-8" max="8" decimals="3"><name>Phase speed adjustment</name></parameter>
    <parameter type="animated" name="z_distance_adjust" default="1" min="0.001" max="8" decimals="3"><name>Z distance multiplier</name></parameter>
    <parameter type="animated" name="wrap_x" default="2" min="0" max="2" decimals="0"><name>Horizontal edge mode</name></parameter>
    <parameter type="animated" name="wrap_y" default="2" min="0" max="2" decimals="0"><name>Vertical edge mode</name></parameter>
    <parameter type="animated" name="subpixel" default="1" min="0" max="1" decimals="0"><name>Subpixel sampling</name></parameter>
    <parameter type="fixed" name="native_curves" default="{}" />
    <parameter type="fixed" name="center_x" default="0.5" />
    <parameter type="fixed" name="center_y" default="0.5" />
    <parameter type="fixed" name="amplitude" default="0" />
    <parameter type="fixed" name="frequency" default="1" />
    <parameter type="fixed" name="angle" default="0" />
    <parameter type="fixed" name="displace_angle" default="90" />
    <parameter type="fixed" name="phase_start" default="0" />
    <parameter type="fixed" name="phase_speed" default="0" />
    <parameter type="fixed" name="z_distance" default="1" />
    <parameter type="fixed" name="native_event_frames" default="0" />
    <parameter type="fixed" name="native_nominal_frames" default="0" />
    <parameter type="fixed" name="native_curve_start" default="0" />
    <parameter type="fixed" name="native_curve_end" default="1" />
    <parameter type="fixed" name="native_event_role" default="outgoing" />
    <parameter type="fixed" name="native_fit_version" default="0" />
    <parameter type="fixed" name="native_preset_id" default="" />
    <parameter type="fixed" name="native_preset_schema_version" default="0" />
</effect>
