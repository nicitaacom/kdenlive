<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="kdenlive_magnify_warp" id="kdenlive_magnify_warp" type="video">
    <name>Elliptical Magnify Warp</name>
    <description>Native elliptical lens coordinate mapping with source-derived reflected edges. The taper and sampling kernel approximate Sapphire WarpMagnify.</description>
    <author>Kdenlive</author>
    <parameter type="animated" name="magnify_amount_adjust" default="1" min="0.001" max="8" decimals="3"><name>Magnification multiplier</name></parameter>
    <parameter type="animated" name="magnify_rel_x_adjust" default="1" min="0.001" max="8" decimals="3"><name>Horizontal magnification multiplier</name></parameter>
    <parameter type="animated" name="magnify_rel_y_adjust" default="1" min="0.001" max="8" decimals="3"><name>Vertical magnification multiplier</name></parameter>
    <parameter type="animated" name="center_x_adjust" default="0" min="-1" max="1" decimals="3"><name>Center X adjustment</name></parameter>
    <parameter type="animated" name="center_y_adjust" default="0" min="-1" max="1" decimals="3"><name>Center Y adjustment</name></parameter>
    <parameter type="animated" name="lens_radius_adjust" default="1" min="0.001" max="8" decimals="3"><name>Lens radius multiplier</name></parameter>
    <parameter type="animated" name="lens_edge_width_adjust" default="1" min="0.001" max="8" decimals="3"><name>Edge width multiplier</name></parameter>
    <parameter type="animated" name="lens_rel_width_adjust" default="1" min="0.001" max="8" decimals="3"><name>Lens width multiplier</name></parameter>
    <parameter type="animated" name="lens_rel_height_adjust" default="1" min="0.001" max="8" decimals="3"><name>Lens height multiplier</name></parameter>
    <parameter type="animated" name="lens_rotate_adjust" default="0" min="-360" max="360" decimals="2"><name>Lens rotation adjustment</name></parameter>
    <parameter type="animated" name="lens_edge_shape_adjust" default="0" min="-1" max="1" decimals="3"><name>Edge shape adjustment</name></parameter>
    <parameter type="animated" name="wrap_x" default="2" min="0" max="2" decimals="0"><name>Horizontal edge mode</name></parameter>
    <parameter type="animated" name="wrap_y" default="2" min="0" max="2" decimals="0"><name>Vertical edge mode</name></parameter>
    <parameter type="animated" name="subpixel" default="1" min="0" max="1" decimals="0"><name>Subpixel sampling</name></parameter>
    <parameter type="fixed" name="native_curves" default="{}" />
    <parameter type="fixed" name="magnify_amount" default="1" />
    <parameter type="fixed" name="magnify_rel_x" default="1" />
    <parameter type="fixed" name="magnify_rel_y" default="1" />
    <parameter type="fixed" name="center_x" default="0.5" />
    <parameter type="fixed" name="center_y" default="0.5" />
    <parameter type="fixed" name="lens_radius" default="1" />
    <parameter type="fixed" name="lens_edge_width" default="1" />
    <parameter type="fixed" name="lens_rel_width" default="1" />
    <parameter type="fixed" name="lens_rel_height" default="1" />
    <parameter type="fixed" name="lens_rotate" default="0" />
    <parameter type="fixed" name="lens_edge_shape" default="1" />
    <parameter type="fixed" name="native_nominal_frames" default="0" />
    <parameter type="fixed" name="native_event_frames" default="0" />
    <parameter type="fixed" name="native_curve_start" default="0" />
    <parameter type="fixed" name="native_curve_end" default="1" />
    <parameter type="fixed" name="native_event_role" default="outgoing" />
    <parameter type="fixed" name="native_fit_version" default="0" />
    <parameter type="fixed" name="native_preset_id" default="" />
    <parameter type="fixed" name="native_preset_schema_version" default="0" />
</effect>
